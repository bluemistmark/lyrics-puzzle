# .env.local로 복사해서 로컬 값을 채우세요. (.env.local은 git에 올라가지 않습니다)
# Vercel에는 같은 이름으로 Project Settings > Environment Variables에 등록합니다.

# 공개돼도 되는 값: 어드민 화면(브라우저)에서 사용. 데이터 접근은 RLS가 관리자에게만 허용합니다.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 비밀 값: 빌드 스크립트와 /api/publish에서만 사용. 절대 VITE_ 접두사를 붙이지 마세요(브라우저 번들에 노출됨).
SUPABASE_SERVICE_ROLE_KEY=
# Vercel > Project Settings > Git > Deploy Hooks에서 main 브랜치용으로 만든 URL
VERCEL_DEPLOY_HOOK_URL=
